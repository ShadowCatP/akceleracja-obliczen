#!/bin/bash
set -e

echo "pre-commit checks..."

echo "formatting files..."
for file in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|cu)$' || true); do
  if [ -f "$file" ]; then
    clang-format -i "$file"
    git add "$file"
  fi
done

if git diff --cached --name-only --diff-filter=ACM | grep -Eq '(^|/)(CMakeLists\.txt|.*\.(cpp|hpp|cu|cmake))$'; then
  echo "verifying build..."
  cmake -S . -B build
  cmake --build build --config Debug
else
  echo "no source files changed, skipping build..."
fi

echo "pre-commit checks passed"